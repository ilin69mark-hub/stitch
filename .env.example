# Public site URL used for canonical links, sitemap and payment return URLs.
# Use an HTTPS origin in production, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Directory for SQLite and uploaded photos. Must be writable by the app.
# Prefer an absolute path outside the repository in production.
DATA_DIR=./data

# Maximum upload size in megabytes. The server also checks pixel dimensions.
UPLOAD_MAX_MB=15

# none | yookassa
# With "none" the order is saved without online payment; no fake payment is created.
PAYMENT_PROVIDER=none

# test | live — informational; real behaviour depends on the YooKassa keys.
PAYMENT_MODE=test

# YooKassa credentials. Leave empty to keep online payment disabled.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3

# Webhook protection. Set a long random value and pass it as ?secret=...
# If empty, the secret check is skipped — do not leave it empty in production.
YOOKASSA_WEBHOOK_SECRET=

# Optional comma-separated IPs/CIDRs allowed to call the webhook.
# If empty, the IP allowlist is disabled.
YOOKASSA_ALLOWED_IPS=

# Admin API token. If empty, /api/admin/* is disabled with HTTP 503.
ADMIN_TOKEN=
